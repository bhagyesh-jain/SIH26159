# Postfix master process configuration file for SecureMailScope Synthetic Lab

postlog   unix-dgram n  -       n       -       1       postlogd
pickup    unix  n       -       n       60      1       pickup
cleanup   unix  n       -       n       -       0       cleanup
qmgr      unix  n       -       n       300     1       qmgr
tlsmgr    unix  -       -       n       1000?   1       tlsmgr
rewrite   unix  -       -       n       -       -       trivial-rewrite
bounce    unix  -       -       n       -       0       bounce
defer     unix  -       -       n       -       0       bounce
trace     unix  -       -       n       -       0       bounce
verify    unix  -       -       n       -       1       verify
flush     unix  n       -       n       1000?   0       flush
proxymap  unix  -       -       n       -       -       proxymap
proxywrite unix -       -       n       -       1       proxymap
smtp      unix  -       -       n       -       -       smtp
relay     unix  -       -       n       -       -       smtp
showq     unix  n       -       n       -       -       showq
error     unix  -       -       n       -       -       error
retry     unix  -       -       n       -       -       error
discard   unix  -       -       n       -       -       discard
local     unix  -       n       n       -       -       local
virtual   unix  -       n       n       -       -       virtual
lmtp      unix  -       -       n       -       -       lmtp
anvil     unix  -       -       n       -       1       anvil
scache    unix  -       -       n       -       1       scache

# Scenario specific listeners
# Port 25: Standard SMTP with STARTTLS (Valid CA cert, TLS 1.2/1.3)
25         inet  n       -       n       -       -       smtpd
  -o smtpd_tls_security_level=may
  -o smtpd_tls_cert_file=/certs/server_valid.crt
  -o smtpd_tls_key_file=/certs/server_valid.key

# Port 2525: Self-Signed Server Certificate
2525       inet  n       -       n       -       -       smtpd
  -o smtpd_tls_security_level=may
  -o smtpd_tls_cert_file=/certs/server_selfsigned.crt
  -o smtpd_tls_key_file=/certs/server_selfsigned.key

# Port 2526: Expired Server Certificate
2526       inet  n       -       n       -       -       smtpd
  -o smtpd_tls_security_level=may
  -o smtpd_tls_cert_file=/certs/server_expired.crt
  -o smtpd_tls_key_file=/certs/server_expired.key

# Port 2527: Plaintext only (No STARTTLS advertised)
2527       inet  n       -       n       -       -       smtpd
  -o smtpd_tls_security_level=none

# Port 2528: Legacy/Weak Cipher Support (Static RSA / Non-PFS permitted)
2528       inet  n       -       n       -       -       smtpd
  -o smtpd_tls_security_level=may
  -o smtpd_tls_cert_file=/certs/server_valid.crt
  -o smtpd_tls_key_file=/certs/server_valid.key
  -o smtpd_tls_protocols=!TLSv1.3
  -o smtpd_tls_mandatory_protocols=!TLSv1.3
  -o smtpd_tls_ciphers=export,low,medium,high
  -o smtpd_tls_mandatory_ciphers=export,low,medium,high
